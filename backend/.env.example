# LM Studio server base URL
LMSTUDIO_BASE_URL=http://localhost:1234
# Chat model identifier loaded in LM Studio
LMSTUDIO_MODEL=medgemma-4b-it-mlx
# Embedding model identifier loaded in LM Studio
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# Request timeout to LM Studio, in seconds
LMSTUDIO_TIMEOUT=180
# Embedding backend: lmstudio | ollama | sentence_transformers (changing it needs a new COLLECTION_NAME or re-ingest)
EMBEDDING_BACKEND=lmstudio
# Only used when EMBEDDING_BACKEND=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
# Only used when EMBEDDING_BACKEND=sentence_transformers
ST_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Folder with the Colab-trained topic files (menstrual_bertopic_model, document_store.json, cloud_terms.json, charts); defaults to backend/contents
INSYNC_DATA_DIR=
# Extra comma-separated CORS origins (localhost:5173 and 127.0.0.1:5173 are always allowed)
CORS_ORIGINS=

# Max Chroma distance (l2; lower = more similar) for a retrieved chunk to be put in the prompt.
# Ignored when a specific report (source_id) is selected. Measured: relevant 0.28-0.76, unrelated >=0.94.
RAG_MAX_DISTANCE=0.85
# Hugging Face token, used to download the topic model's embedding model (pritamdeka/S-Scibert-snli-multinli-stsb)
HF_TOKEN=
